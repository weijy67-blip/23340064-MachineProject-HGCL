# 创建 .gitignore 文件，忽略不需要的文件
@"
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# PyCharm
.idea/
*.iml

# Dataset
data/*.zip
data/*.tar.gz
*.pkl
*.h5
*.npy
"@ | Out-File .gitignore -Encoding UTF8